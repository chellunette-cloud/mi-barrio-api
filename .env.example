# Desarrollo local.
PORT=3000
HOST=127.0.0.1
BACKEND_URL=http://127.0.0.1:3001
# Debe coincidir con el SERVICE_TOKEN del backend.
SERVICE_TOKEN=CHANGE_ME_SERVICE_TOKEN_32_CHARS
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Límite de solicitudes por minuto. Producción usa 120 por defecto y rechaza
# valores superiores. Solo para local/test se puede habilitar 600 porque la
# suite E2E completa supera 120 solicitudes/min.
# RATE_LIMIT_MAX=600

# Despliegue en red privada de contenedores:
# NODE_ENV=production
# HOST=0.0.0.0
# BACKEND_URL=http://mi-barrio-backend:3001
# FRONTEND_ORIGIN=https://mi-barrio.example
# El backend no se publica en Internet; solo la API es la frontera pública.
